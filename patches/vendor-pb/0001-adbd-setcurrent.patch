From c90e075621687d94575fee26c54bc1aea7e189bf Mon Sep 17 00:00:00 2001
From: johnmart19 <johnivan19999@gmail.com>
Date: Mon, 5 Oct 2026 03:16:28 +0000
Subject: [PATCH] sepolicy: Allow recovery adbd to change its current context

Permit the user-build recovery adbd setcurrent operation within recovery policy only. Neverallow checks remain enabled.

Co-authored-by: codex <noreply@openai.com>
---
 sepolicy/public/twrp.te | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/sepolicy/public/twrp.te b/sepolicy/public/twrp.te
index 5bd0fe0..9ac030c 100644
--- a/sepolicy/public/twrp.te
+++ b/sepolicy/public/twrp.te
@@ -14,3 +14,8 @@ recovery_only(`
   allow unlabeled unlabeled:filesystem associate;
   allow vendor_init rootfs:dir read;
 ')
+
+# Recovery user-build adbd explicitly changes to the shell domain.
+recovery_only(`
+  allow adbd self:process setcurrent;
+')
