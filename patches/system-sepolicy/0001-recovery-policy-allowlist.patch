From b91dfe8f67f1bf9589ccd22e7c6b0f81c994287d Mon Sep 17 00:00:00 2001
From: johnmart19 <johnivan19999@gmail.com>
Date: Mon, 5 Oct 2026 17:35:11 +0000
Subject: [PATCH] recovery: Allow upstream PBRP service domains on user builds

Allow only seven upstream PBRP permissive domains in the recovery policy binary. Retain neverallow and Android system/vendor policy checks.

Co-authored-by: codex <noreply@openai.com>
Change-Id: I51340882553209aa1a6b50412316111923a1b532
---
 Android.bp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/Android.bp b/Android.bp
index 4028215..e059738 100644
--- a/Android.bp
+++ b/Android.bp
@@ -806,6 +806,10 @@ se_policy_cil {
 
 se_policy_binary {
     name: "sepolicy.recovery",
+    // Upstream PBRP recovery services; does not change Android policy checks.
+    permissive_domains_on_user_builds: [
+        "recovery", "init", "logd", "adbd", "fastbootd", "postinstall", "ueventd",
+    ],
     srcs: [":recovery_sepolicy.cil"],
     stem: "sepolicy",
     recovery: true,
-- 
2.53.0

